#!/usr/bin/env node
// kit: screenshot the Overlay's Scenes tab and the toolbar Prompter link button in the browser QA preview
// Usage: kit shots [--help]
// Serves src/ on a free 127.0.0.1 port, opens overlay.html without Electron (its QA bridge fake runs
// the real Scene library), opens Inline settings on the Scenes tab and captures the list and grid
// views with the starter, no and six Scenes, autosave with Undo, delete with Undo, rename, the save
// form, high contrast focus, then the toolbar's Prompter link button off, on and busy.
// Evidence: .scratch/shots/<time>/.
import { createServer } from 'node:http'
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { extname, join, normalize, resolve, sep } from 'node:path'
import { pathToFileURL } from 'node:url'
import { execFileSync } from 'node:child_process'

if (process.argv.includes('--help') || process.argv.includes('-h')) {
  console.log(`Usage: kit shots
Serves src/ locally and opens overlay.html in Chromium without Electron (the browser QA preview, whose bridge
fake runs the real Scene library on a pretend 1920x1080 display), then captures Inline settings on the Scenes
tab: the grid and list views with the two starter Scenes, no Scenes and six Scenes, at the default Overlay
size (324x390) and a tall 324x820 view; a Scene put on camera with the settings staying open; a shape change
saved into it with its check and Undo; Ctrl+Z; a delete with Undo (focus on Undo) and Undo from the keyboard;
rename (F2); the save form with a taken name (Replace); Escape closing the settings; keyboard focus in high
contrast. Then the toolbar's Prompter link button off, on (from the keyboard) and busy, checking all six
toolbar buttons fit the default Overlay. Fails on page errors, a removed control coming back (Start at
login, the shortcut list, the Prompter link section) or a missing or wrong state.
Playwright comes from KIT_PLAYWRIGHT_MODULE, else "playwright" in scripts/agents/kit.json (the repo's own
playwright-core after npm ci; Chromium for it comes from npx playwright-core install chromium).
Evidence: .scratch/shots/<time>/shots.json and *.png.`)
  process.exit(0)
}

const root = process.env.KIT_ROOT || execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim()
const settings = JSON.parse(readFileSync(join(root, 'scripts/agents/kit.json'), 'utf8'))
// A relative "playwright" is inside this repo (its own playwright-core devDependency, after npm ci).
const playwrightSetting = process.env.KIT_PLAYWRIGHT_MODULE || settings.playwright
const playwrightPath = playwrightSetting && resolve(root, playwrightSetting)
const out = join(root, '.scratch', 'shots', new Date().toISOString().replace(/[:.]/g, '-'))
mkdirSync(out, { recursive: true })
const fail = (message) => {
  console.log(`RESULT: fail shots ${message} evidence ${out}`)
  process.exit(1)
}
if (!playwrightPath) fail('no Playwright (set KIT_PLAYWRIGHT_MODULE or "playwright" in kit.json)')
if (!existsSync(playwrightPath)) fail(`no Playwright at ${playwrightPath} (run npm ci, or set KIT_PLAYWRIGHT_MODULE)`)

const types = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.woff2': 'font/woff2', '.svg': 'image/svg+xml', '.png': 'image/png' }
const srcRoot = resolve(root, 'src')
const server = createServer((request, response) => {
  const path = normalize(join(srcRoot, decodeURIComponent(new URL(request.url, 'http://x').pathname)))
  if (!path.startsWith(srcRoot + sep)) {
    response.writeHead(403).end()
    return
  }
  try {
    const body = readFileSync(path)
    response.writeHead(200, { 'Content-Type': types[extname(path)] ?? 'application/octet-stream' }).end(body)
  } catch {
    response.writeHead(404).end()
  }
})
await new Promise((done) => server.listen(0, '127.0.0.1', done))
const base = `http://127.0.0.1:${server.address().port}/overlay.html`

const { chromium } = await import(pathToFileURL(playwrightPath).href)
const browser = await chromium.launch()
const shots = []
const errors = []

async function openScenes({ query = '', width = 324, height = 390, forcedColors, scale = 1 } = {}) {
  const page = await browser.newPage({ viewport: { width, height }, deviceScaleFactor: scale })
  if (forcedColors) await page.emulateMedia({ forcedColors })
  page.on('pageerror', (error) => errors.push(`${query || 'default'}: ${error.message}`))
  await page.goto(`${base}?${query}`)
  await page.locator('#overlay').waitFor({ state: 'visible' })
  await page.locator('#camera-surface').hover()
  await page.locator('#controls-button').click()
  await page.locator('#inline-settings').waitFor({ state: 'visible' })
  await page.locator('[data-settings-tab="presets"]').click()
  await page.locator('#scenes-panel .scenes-head').waitFor({ state: 'visible' })
  return page
}

const readPanel = (page) =>
  page.evaluate(() => ({
    view: document.querySelector('#scenes-panel .scene-body')?.dataset.layout,
    scenes: [...document.querySelectorAll('#scenes-panel .scene-main')].map((item) => item.getAttribute('aria-label')),
    add: document.querySelector('#scenes-panel :is(.scene-add, .scene-add-tile) .scene-name')?.textContent ?? '',
    deleted: [...document.querySelectorAll('#scenes-panel .scene-deleted-name')].map((item) => item.textContent),
    undo: document.querySelectorAll('#scenes-panel [data-act="undo-change"]').length,
    savedCheck: document.querySelectorAll('#scenes-panel .scene-slot.saved').length,
    settingsOpen: !document.querySelector('#inline-settings').hidden,
    gone: ['#overlay-launch-toggle', '.shortcut-list', '#overlay-prompter-toggle', '#overlay-prompter-margin'].filter((selector) => document.querySelector(selector)),
  }))

async function shoot(page, file, extra = {}) {
  await page.screenshot({ path: join(out, file), animations: 'disabled' })
  const state = await readPanel(page)
  if (state.gone.length) fail(`removed controls are back: ${state.gone.join(', ')}`)
  shots.push({ file, ...extra, ...state })
  return state
}

try {
  // Each Scene set in both views, at the default Overlay size and a tall view.
  for (const view of [
    { name: 'default', width: 324, height: 390 },
    { name: 'tall', width: 324, height: 820 },
  ]) {
    for (const scenes of ['starter', 'empty', 'full']) {
      const page = await openScenes({ query: `scenes=${scenes}`, width: view.width, height: view.height, scale: 2 })
      for (const layout of ['grid', 'list']) {
        await page.locator(`[data-view="${layout}"]`).click()
        await page.waitForTimeout(80)
        const state = await shoot(page, `scenes-${scenes}-${layout}-${view.name}.png`, { view, scenes, layout })
        if (state.view !== layout) fail(`the ${layout} switch shows ${state.view}`)
        const expectedAdd = { starter: 'Save look', empty: 'Save the live look as scene 1', full: 'Full' }[scenes]
        if (state.add !== expectedAdd) fail(`the save slot says "${state.add}" for ${scenes} Scenes, not "${expectedAdd}"`)
        if (scenes === 'empty' && state.scenes.length) fail('the empty state shows Scenes')
      }
      await page.close()
    }
  }

  // Autosave, Undo, delete with Undo, rename and the save form, with the settings staying open.
  for (const layout of ['grid', 'list']) {
    const page = await openScenes({ query: 'scenes=starter', height: 600, scale: 2 })
    await page.locator(`[data-view="${layout}"]`).click()
    await page.locator('.scene-main', { hasText: 'Big right' }).click()
    await page.waitForTimeout(80)
    let state = await readPanel(page)
    if (!state.settingsOpen) fail(`putting a Scene on camera closed the settings (${layout})`)
    if (!state.scenes.find((label) => label.startsWith('Big right') && label.includes('on camera'))) {
      fail(`Big right is not marked on camera (${layout}: ${JSON.stringify(state.scenes)})`)
    }
    await page.locator('#shape-button').click({ force: true })
    await page.waitForTimeout(120)
    state = await shoot(page, `scenes-autosaved-${layout}.png`, { layout, step: 'autosave' })
    if (state.undo !== 1 || state.savedCheck !== 1) fail(`autosave shows ${state.undo} Undo and ${state.savedCheck} checks (${layout})`)
    await page.keyboard.press('Control+z')
    await page.waitForTimeout(80)
    state = await readPanel(page)
    if (state.undo !== 0) fail(`Ctrl+Z left Undo showing (${layout})`)
    await page.locator('.scene-main', { hasText: 'Small bottom' }).focus()
    await page.keyboard.press('Delete')
    await page.waitForTimeout(80)
    state = await shoot(page, `scenes-deleted-${layout}.png`, { layout, step: 'delete' })
    if (state.deleted[0] !== 'Small bottom deleted') fail(`delete shows ${JSON.stringify(state.deleted)} (${layout})`)
    const focused = await page.evaluate(() => document.activeElement?.dataset.act)
    if (focused !== 'undo-delete') fail(`focus after delete is on ${focused}, not Undo (${layout})`)
    await page.keyboard.press('Enter')
    await page.waitForTimeout(80)
    state = await readPanel(page)
    if (state.scenes.length !== 2) fail(`Undo did not bring the Scene back (${layout})`)
    await page.locator('.scene-main', { hasText: 'Big right' }).focus()
    await page.keyboard.press('F2')
    await page.locator('[data-role="rename"]').waitFor({ state: 'visible' })
    await shoot(page, `scenes-rename-${layout}.png`, { layout, step: 'rename' })
    await page.keyboard.press('Escape')
    await page.locator('[data-act="save-open"]').click()
    await page.locator('[data-role="new-name"]').fill('small bottom')
    await shoot(page, `scenes-save-replace-${layout}.png`, { layout, step: 'save form, name taken' })
    const replace = await page.locator('[data-act="save-ok"]').textContent()
    if (!replace.includes('Replace')) fail(`the save button does not say Replace for a taken name (${layout})`)
    await page.keyboard.press('Escape')
    await page.keyboard.press('Escape')
    await page.waitForTimeout(60)
    if (!(await page.locator('#inline-settings').isHidden())) fail(`Escape did not close the settings (${layout})`)
    await page.close()
  }

  // High contrast: keyboard focus stays visible on a tile, the view switch and a file button.
  for (const layout of ['grid', 'list']) {
    const page = await openScenes({ query: 'scenes=starter', height: 600, forcedColors: 'active', scale: 2 })
    await page.locator(`[data-view="${layout}"]`).click()
    const focus = {}
    for (const selector of ['.scene-main', `[data-view="${layout}"]`, '[data-act="import"]']) {
      await page.keyboard.press('Shift')
      await page.locator(selector).first().focus()
      focus[selector] = await page.locator(selector).first().evaluate((item) => ({
        visible: item.matches(':focus-visible'),
        outline: getComputedStyle(item).outlineStyle,
      }))
      if (!focus[selector].visible || focus[selector].outline === 'none') {
        fail(`no visible keyboard focus on ${selector} in high contrast (${JSON.stringify(focus[selector])})`)
      }
    }
    await page.locator('.scene-main').first().focus()
    await shoot(page, `scenes-high-contrast-${layout}.png`, { layout, highContrastFocus: focus })
    await page.close()
  }

  // The toolbar's Prompter link button: off, on (from the keyboard) and busy, at 2x cropped to the
  // toolbar, checking all six toolbar buttons fit the default Overlay.
  for (const mode of ['off', 'on', 'busy']) {
    const page = await browser.newPage({ viewport: { width: 324, height: 390 }, deviceScaleFactor: 2 })
    page.on('pageerror', (error) => errors.push(`toolbar/${mode}: ${error.message}`))
    await page.goto(mode === 'busy' ? `${base}?prompter=busy` : base)
    await page.locator('#overlay').waitFor({ state: 'visible' })
    await page.locator('#camera-surface').hover()
    const button = page.locator('#prompter-button')
    if (await button.count() !== 1) fail('the toolbar Prompter link button is missing')
    const fit = await page.evaluate(() => {
      const toolbar = document.querySelector('#hover-toolbar').getBoundingClientRect()
      const buttons = [...document.querySelectorAll('#hover-toolbar > button')].map((item) => item.getBoundingClientRect())
      return {
        count: buttons.length,
        inside: buttons.every((rect) => rect.left >= toolbar.left && rect.right <= toolbar.right),
        narrowest: Math.min(...buttons.map((rect) => rect.width)),
        toolbarInView: toolbar.left >= 0 && toolbar.right <= window.innerWidth,
      }
    })
    if (fit.count !== 6 || !fit.inside || fit.narrowest < 36 || !fit.toolbarInView) {
      fail(`the toolbar does not fit the default Overlay (${JSON.stringify(fit)})`)
    }
    if (mode === 'on') {
      await button.focus()
      await page.keyboard.press('Enter')
    }
    if (mode === 'busy') await button.click()
    await page.locator('#camera-surface').hover()
    await page.waitForTimeout(250)
    const state = await page.evaluate(() => {
      const item = document.querySelector('#prompter-button')
      return {
        pressed: item.getAttribute('aria-pressed'),
        linkState: item.dataset.linkState,
        title: item.title,
        selected: item.classList.contains('selected'),
        description: document.querySelector('#overlay-prompter-status').textContent,
      }
    })
    const expected = { off: ['false', 'off', false], on: ['true', 'on', true], busy: ['true', 'error', true] }[mode]
    if (state.pressed !== expected[0] || state.linkState !== expected[1] || state.selected !== expected[2]) {
      fail(`the toolbar button shows the wrong state for ${mode} (${JSON.stringify(state)})`)
    }
    const file = `toolbar-prompter-${mode}.png`
    const box = await page.locator('#hover-toolbar').boundingBox()
    await page.screenshot({
      path: join(out, file),
      clip: { x: box.x - 8, y: box.y - 8, width: box.width + 16, height: box.height + 16 },
      animations: 'disabled',
    })
    shots.push({ file, mode, fit, ...state })
    await page.close()
  }
} catch (error) {
  errors.push(error.message.split('\n')[0])
} finally {
  await browser.close()
  server.close()
}
writeFileSync(join(out, 'shots.json'), JSON.stringify({ shots, errors }, null, 2))
if (errors.length) fail(`${errors.length} page error(s): ${errors[0]}`)
console.log(`RESULT: ok shots ${shots.length} screenshots evidence ${out}`)
