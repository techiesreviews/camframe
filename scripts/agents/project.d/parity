#!/usr/bin/env bash
# kit: capture the unchanged Electron 0.9.0 controls beside real Rust desktop screenshots
# Usage: kit parity <output-directory> <native-screenshot-directory>
set -euo pipefail
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo 'Usage: kit parity <output-directory> <native-screenshot-directory>'
  echo 'Requires a desktop, Electron, playwright-core and the release compare-parity binary.'
  exit 0
fi
root=$(git rev-parse --show-toplevel)
node "$root/rust/scripts/capture-parity.mjs" "$@"
